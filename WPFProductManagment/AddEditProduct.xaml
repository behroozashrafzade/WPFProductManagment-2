<Window x:Class="WPFProductManagment.AddEditProduct"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFProductManagment"
        mc:Ignorable="d"
        Title="AddEditProduct" Height="400" Width="700">
    <Grid>
        <StackPanel Margin="20">
            <DockPanel Margin="10">
                <Label Margin="10">Name :</Label>
                <TextBox HorizontalAlignment="Right" Width="500" Name="tbName"></TextBox>
            </DockPanel>
            <DockPanel Margin="10">
                <Label Margin="10">Author :</Label>
                <TextBox HorizontalAlignment="Right" Width="500" Name="tbAuthor"></TextBox>
            </DockPanel>
            <DockPanel Margin="10">
                <Label Margin="10">Available :</Label>
                <TextBox HorizontalAlignment="Right" Width="500" Name="tbAvailable"></TextBox>
            </DockPanel>
            <DockPanel Margin="10">
                <Label Margin="10">Price  :</Label>
                <TextBox HorizontalAlignment="Right" Width="500" Name="tbPrice"></TextBox>
            </DockPanel>
            

            <DockPanel Margin="10" HorizontalAlignment="Right">
                <Button Margin="10" Height="50" Width="120" Name="btnCancel" Click="BtnCancel_OnClick">Cancel</Button>
                <Button Margin="10" Height="50" Width="120" Name="btnOk" Click="BtnOk_OnClick">Ok</Button>

            </DockPanel>
        </StackPanel>
    </Grid>
</Window>
