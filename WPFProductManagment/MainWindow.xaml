<Window x:Class="WPFProductManagment.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFProductManagment"
        mc:Ignorable="d"
        Title="Vision Academy management App" Height="700" Width="1200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />

        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Margin="2" Background="#fbd4e6" Width="250" HorizontalAlignment="Center"
                BorderThickness="2" BorderBrush="Black">
            <StackPanel>
                <Button Margin="20,30" Background="#3E454C" Height="50" Foreground="White" FontSize="22" Name="BtnHome" Click="BtnHome_OnClick">Home</Button>
                <Button Margin="20,30" Background="#3E454C" Height="50" Foreground="White" FontSize="22"
                        Name="BtnEmployees" Click="BtnEmployees_OnClick">
                    Employees
                </Button>
                <Button Margin="20,30" Background="#3E454C" Height="50" Foreground="White" FontSize="22" Name="BtnCustomers" Click="BtnCustomers_OnClick">
                    Customers
                </Button>
                <Button Margin="20,30" Background="#3E454C" Height="50" Foreground="White" FontSize="22" Name="BtnProducts" Click="BtnProducts_OnClick">
                    Products
                </Button>
                <Image Margin="10,60" Height="100" Width="150" Source="Resourcies/Screenshot 2025-06-08 125713.png" ></Image>
            </StackPanel>
        </Border>
        <Border Grid.Column="1" Margin="2" Visibility="Visible" Background="WhiteSmoke" Name="HomePanel" HorizontalAlignment="Stretch"
                BorderThickness="2" BorderBrush="Black">

            <StackPanel HorizontalAlignment="Stretch" Background="#fbd4e6">
            <Label FontSize="32" FontWeight="Heavy" HorizontalAlignment="Center" FontFamily="Times New Roman" Margin="0,50,0,0">Welcome to Program my behrouz ashrafzade </Label>
            
        </StackPanel>
        </Border>
        <Border Grid.Column="1" Margin="2" Visibility="Collapsed" Background="WhiteSmoke" Name="EmployeesPanel" HorizontalAlignment="Stretch" BorderThickness="2" BorderBrush="Black">
            <StackPanel HorizontalAlignment="Stretch" Background="DarkSalmon" Margin="15">
                <DataGrid Margin="5" Name="EmployeesGrid" ColumnWidth="*" CanUserAddRows="False" MinColumnWidth="100" CanUserResizeColumns="True" SelectionChanged="EmployeesGrid_OnSelectionChanged">

                </DataGrid>
            <Grid Margin="5">
                <Grid.RowDefinitions>
                        <RowDefinition Height="150"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                <WrapPanel Margin="5" Grid.Row="0">
                        <Label Margin="2" FontWeight="Bold">Detailed Info:</Label>
                        <Label Margin="2" Content="---" Name="Employeelabel"></Label>

                </WrapPanel>
                    <DockPanel HorizontalAlignment="Center" Margin="20" Grid.Row="1">
                        <Button Margin="10" Height="50" Width="150" Background="LightGreen" Name="btnAddEmployee" Click="BtnAddEmployee_OnClick">Add Employee</Button>
                        <Button Margin="10" Height="50" Width="150" Background="Salmon" Name="btnDeleteEmployee" Click="BtnDeleteEmployee_OnClick">Delete</Button>
                        <Button Margin="10" Height="50" Width="150" Background="WhiteSmoke" Name="btnEditEmployee" Click="BtnEditEmployee_OnClick">Edit</Button>
                    </DockPanel>

            </Grid>
            </StackPanel>
        </Border>
        <Border Grid.Column="1" Margin="2" Visibility="Collapsed" Background="WhiteSmoke" Name="CustomersPanel" HorizontalAlignment="Stretch" BorderThickness="2" BorderBrush="Black">
            <Label FontSize="48"  HorizontalAlignment="Center" FontFamily="Times New Roman" >Welcome to Page Customers</Label>
        </Border>
        <Border Grid.Column="1" Margin="2" Visibility="Collapsed" Background="WhiteSmoke" Name="ProductsPanel" HorizontalAlignment="Stretch" BorderThickness="2" BorderBrush="Black">
            <Label FontSize="48"  HorizontalAlignment="Center" FontFamily="Times New Roman" >Welcome to Page Products</Label>
        </Border>

    </Grid>
</Window>
